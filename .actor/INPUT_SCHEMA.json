{
    "title": "Web Crawler with Proxy Support",
    "description": "Advanced web crawler with configurable output filename and proxy support.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "outputFilename": {
            "title": "✅ Output Filename (REQUIRED)",
            "type": "string",
            "description": "Name of the output file (without .json extension) - This field is required",
            "minLength": 1,
            "maxLength": 100,
            "editor": "textfield",
            "prefill": "memc-specialists"
        },
        "proxyConfiguration": {
            "title": "🌐 Proxy Configuration",
            "type": "object",
            "description": "Configure proxy settings for the crawler",
            "properties": {
                "useProxy": {
                    "title": "Enable Proxy",
                    "type": "boolean",
                    "description": "Enable proxy usage for requests",
                    "default": false,
                    "editor": "checkbox"
                },
                "proxyUrls": {
                    "title": "Proxy URLs",
                    "type": "array",
                    "description": "List of proxy URLs (e.g., http://username:password@proxy.example.com:8080)",
                    "items": {
                        "type": "string",
                        "pattern": "^https?://.*"
                    },
                    "editor": "stringList",
                    "sectionCaption": "Enter one proxy URL per line"
                },
                "proxyCountry": {
                    "title": "Proxy Country",
                    "type": "string",
                    "description": "Country code for proxy selection (e.g., US, GB, DE)",
                    "pattern": "^[A-Z]{2}$",
                    "editor": "textfield",
                    "prefill": "US"
                },
                "proxyRotation": {
                    "title": "Proxy Rotation",
                    "type": "string",
                    "description": "How to rotate between proxies",
                    "enum": ["perRequest", "perPage", "perSession"],
                    "default": "perRequest",
                    "editor": "select"
                },
                "proxyRetryCount": {
                    "title": "Proxy Retry Count",
                    "type": "integer",
                    "description": "Number of times to retry with different proxy on failure",
                    "minimum": 0,
                    "maximum": 10,
                    "default": 3,
                    "editor": "number"
                },
                "proxyTimeout": {
                    "title": "Proxy Timeout (seconds)",
                    "type": "integer",
                    "description": "Timeout for proxy connections in seconds",
                    "minimum": 5,
                    "maximum": 300,
                    "default": 30,
                    "editor": "number"
                }
            }
        }
    },
    "required": [
        "outputFilename"
    ]
}