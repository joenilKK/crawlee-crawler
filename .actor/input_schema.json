{
  "title": "Data.gov.sg Crawler Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "resourceMap": {
      "title": "Resource IDs",
      "type": "object",
      "description": "Key-value mapping of resource IDs to crawl from data.gov.sg (supports a-z)",
      "editor": "object",
      "properties": {
        "a": {
          "type": "string",
          "title": "Resource A",
          "description": "Resource ID for key 'a'"
        },
        "b": {
          "type": "string",
          "title": "Resource B", 
          "description": "Resource ID for key 'b'"
        },
        "c": {
          "type": "string",
          "title": "Resource C",
          "description": "Resource ID for key 'c'"
        },
        "d": {
          "type": "string",
          "title": "Resource D",
          "description": "Resource ID for key 'd'"
        },
        "e": {
          "type": "string",
          "title": "Resource E",
          "description": "Resource ID for key 'e'"
        }
      },
      "additionalProperties": false
    },
    "startDate": {
      "title": "Start Date",
      "type": "string",
      "description": "Start date for data crawling (YYYY-MM-DD format). Must be a valid date and not after End Date.",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 10,
      "maxLength": 10
    },
    "endDate": {
      "title": "End Date", 
      "type": "string",
      "description": "End date for data crawling (YYYY-MM-DD format). Must be a valid date and not before Start Date.",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "minLength": 10,
      "maxLength": 10
    }
  },
  "required": ["resourceMap", "startDate", "endDate"]
}
